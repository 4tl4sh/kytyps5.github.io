{
  "name": "kytyps5-reimagined",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "fetch:data": "node scripts/refresh-github.mjs",
    "export:site-compat": "node scripts/export-data.mjs",
    "generate:kitty": "node scripts/generate-kitty-loader.mjs",
    "prebuild": "npm run validate:compat && npm run fetch:data && npm run export:site-compat",
    "dev": "npm run export:site-compat && vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc -b",
    "validate:compat": "node scripts/validate-compat.mjs",
    "import": "node scripts/import-games.mjs",
    "export:compat": "node scripts/export-compat-json.mjs --pretty",
    "export:community": "node scripts/export-community.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "test:unit": "vitest run",
    "test:community": "vitest run scripts/lib/community.test.mjs scripts/lib/forks-workflow.test.mjs",
    "test:ci": "node scripts/verify-ci.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node scripts/verify.mjs",
    "test:enhancements": "node scripts/verify-enhancements.mjs",
    "test:hero": "node scripts/verify-hero-deck.mjs",
    "test:cache": "node scripts/verify-cache-ripple.mjs",
    "test:ripple": "node scripts/verify-ripple-render.mjs",
    "test:functionality": "node scripts/verify-functionality.mjs",
    "test:audit-fixes": "node scripts/verify-audit-fixes.mjs",
    "test:featured": "node scripts/verify-featured.mjs",
    "test:community-ui": "node scripts/verify-community.mjs",
    "format": "prettier --write \"src/**/*.tsx\" \"src/**/*.ts\" \"src/*.css\" \"scripts/*.mjs\" vite.config.ts index.html"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders": "latest",
    "@fontsource-variable/public-sans": "latest",
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-tabs": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "react-router-dom": "latest",
    "remark-gfm": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "gifenc": "^1.0.3",
    "playwright": "latest",
    "prettier": "^3.9.10",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
